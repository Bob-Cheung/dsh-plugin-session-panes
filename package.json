{
  "name": "@bob-cheung/dsh-session-panes",
  "version": "1.0.0",
  "license": "MIT",
  "author": "Bob Cheung",
  "description": "Open sessions side by side in the right sidebar: drag a session row onto the right area to add it as a pane.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bob-Cheung/deepseek-harness-plugin-session-panes.git"
  },
  "homepage": "https://github.com/Bob-Cheung/deepseek-harness-plugin-session-panes#readme",
  "bugs": {
    "url": "https://github.com/Bob-Cheung/deepseek-harness-plugin-session-panes/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "sidebar",
    "session",
    "panes"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
